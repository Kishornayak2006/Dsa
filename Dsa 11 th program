11 a) A hospital maintains a queue of patients waiting for consultation. Patients arrive and join  the queue at the registration desk, while doctors call patients for consultation in the order of their arrival (First-In-First-Out - FIFO). The receptionist needs a system to add new patients, remove patients who have been attended to, and display the current waiting list.  Write a C program to implement a Queue using Arrays with the following operations:
              a. Insert (Enqueue): Add a new patient to the queue.
              b. Delete (Dequeue): Remove the patient who has been waiting the longest.
              c. Display: Show all patients currently waiting in the queue.
             Assume the queue size is 5.
#include<stdio.h>
#define MAX 5

int queue[MAX];
int front = -1, rear = -1;

void enqueue(int num)
{
    if (rear == MAX - 1)
    {
        printf("\nOVERFLOW");
        return;
    }
    else if (front == -1 && rear == -1)
    {
        front = rear = 0;
        queue[rear] = num;
    }
    else
    {
        rear++;
        queue[rear] = num;
    }
}

void dequeue()
{
    int val;

    if (front == -1 || front > rear)
    {
        printf("\nUNDERFLOW");
        return;
    }
    else
    {
        val = queue[front];
        printf("\nDeleted Patient ID: %d", val);
        front++;

        if (front > rear)
        {
            front = rear = -1;
        }
    }
}

void display()
{
    int i;

    if (front == -1 || front > rear)
    {
        printf("\nQUEUE EMPTY");
    }
    else
    {
        printf("\nWaiting Patient IDs:\n");

        for (i = front; i <= rear; i++)
        {
            printf("\t%d", queue[i]);
        }
    }
}

int main()
{
    int choice, num;

    while (1)
    {
        printf("\n\n--- HOSPITAL PATIENT QUEUE ---");
        printf("\n1. Insert Patient");
        printf("\n2. Delete Patient");
        printf("\n3. Display Queue");
        printf("\n4. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Enter Patient ID: ");
                scanf("%d", &num);
                enqueue(num);
                break;

            case 2:
                dequeue();
                break;

            case 3:
                display();
                break;

            case 4:
                return 0;
            default:
                printf("\nInvalid Choice");
        }
    }

    return 0;
}

