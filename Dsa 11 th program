11(b).  A shopping mall has a parking area with a fixed number of parking slots. When a vehicle leaves, the vacant slot should be reused efficiently for newly arriving vehicles. To avoid wastage of free slots created at the front of the queue, the parking management system uses  a Circular Queue.
Write a C program to implement a Circular Queue using an Array with the following  operations:
a. Insert (Enqueue): Add a vehicle to the parking queue. 
b. Delete (Dequeue): Remove a vehicle that exits the parking area. 
c. Display: Show all vehicles currently in the circular queue. 
Assume the maximum queue size is 5.

#include<stdio.h>
#define MAX 5
int queue[MAX];
int front = -1, rear = -1;
void insert(int num)
{
    if ((front == 0 && rear == MAX - 1) ||
        (rear == front - 1))
    {
        printf("\nOVERFLOW");
    }
    else if (front == -1 && rear == -1)
    {
        front = rear = 0;
        queue[rear] = num;
    }
    else if (rear == MAX - 1 && front != 0)
    {
        rear = 0;
        queue[rear] = num;
    }
    else
    {
        rear++;
        queue[rear] = num;
    }
}
void delete_element()
{
    if (front == -1 && rear == -1)
    {
        printf("\nQUEUE IS EMPTY");
        return;
    }
    printf("\nDeleted Vehicle ID: %d\n", queue[front]);
    if (front == rear)
    {
        front = rear = -1;
    }
    else if (front == MAX - 1)
    {
        front = 0;
    }
    else
    {
        front++;
    }
}

void display()
{
    int i;

    if (front == -1 && rear == -1)
    {
        printf("\nQUEUE IS EMPTY");
    }
    else
    {
        printf("\nVehicles in Parking Queue:\n");

        if (front <= rear)
        {
            for (i = front; i <= rear; i++)
                printf("\t%d", queue[i]);
        }
        else
        {
            for (i = front; i < MAX; i++)
                printf("\t%d", queue[i]);

            for (i = 0; i <= rear; i++)
                printf("\t%d", queue[i]);
        }
    }
}
int main()
{
    int choice, num;

    while (1)
    {
        printf("\n\n--- PARKING MANAGEMENT SYSTEM ---");
        printf("\n1. Insert Vehicle");
        printf("\n2. Delete Vehicle");
        printf("\n3. Display Vehicles");
        printf("\n4. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);
        switch (choice)
        {
            case 1:
                printf("Enter Vehicle ID: ");
                scanf("%d", &num);
                insert(num);
                break;
            case 2:
                delete_element();
                break;
            case 3:
                display();
                break;
            case 4:
                return 0;
            default:
                printf("\nInvalid Choice");
        }
    }
    return 0;}

